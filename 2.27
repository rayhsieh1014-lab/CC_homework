#include <stdio.h>

int main(void)
{
    /* Five printf statements */
    printf("    *\n");
    printf("   ***\n");
    printf("  *****\n");
    printf(" *******\n");
    printf("*********\n");

    /* One printf statement */
    printf("    *\n   ***\n  *****\n *******\n*********\n");

    return 0;
}
